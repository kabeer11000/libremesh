# LibreMesh Docker Environment Variables
# Copy this to .env and modify as needed

# Network
NETWORK_SECRET=test-secret-change-in-production

# Node URLs (for local Docker testing)
NODE1_URL=http://localhost:8001
NODE2_URL=http://localhost:8002
GATEWAY_URL=http://localhost:8080

# Seed nodes for initial peer discovery
SEED_NODES=["http://localhost:8001","http://localhost:8002"]

# Replication factor
REPLICATION_FACTOR=2

# Ports
NODE1_PORT=8001
NODE2_PORT=8002
GATEWAY_PORT=8080